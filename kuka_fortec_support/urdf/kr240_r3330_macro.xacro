<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find kuka_fortec_support)/urdf/kr_fortec_ros2_control.xacro"/>
  <xacro:include filename="$(find kuka_fortec_support)/urdf/kr_fortec_transmission.xacro"/>
  <xacro:macro name="kuka_kr240_r3330_robot" params="client_ip client_port controller_ip prefix use_fake_hardware roundtrip_time *origin">
    <!-- ros2 control instance -->
    <xacro:kuka_fortec_ros2_control name="${prefix}kr240_r3330" client_ip="${client_ip}" client_port="${client_port}" controller_ip="${controller_ip}" prefix="${prefix}" use_fake_hardware="${use_fake_hardware}" roundtrip_time="${roundtrip_time}"/>
    <link name="world"/>
    <link name="${prefix}base_link">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/base_link.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/base_link.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_1">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_1.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_1.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_2">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_2.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_2.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_3">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_3.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_3.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_4">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_4.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_4.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_5">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_5.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_5.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <link name="${prefix}link_6">
      <collision>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/collision/link_6.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://kuka_fortec_support/meshes/kr240_r3330/visual/link_6.stl"/>
        </geometry>
        <origin rpy="-0.0 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      </visual>
    </link>
    <joint name="${prefix}world-base_link" type="fixed">
      <parent link="world"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <joint name="${prefix}joint_1" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_1"/>
      <limit effort="15000.0E0" lower="${radians(-185)}" upper="${radians(185)}" velocity="${radians(100)}"/>
      <origin rpy="-3.141592653589793 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      <parent link="${prefix}base_link"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_2"/>
      <limit effort="17880.0E0" lower="${radians(-130)}" upper="${radians(20)}" velocity="${radians(90)}"/>
      <origin rpy="${pi/2.0} 0.0 -0.0" xyz="0.5 0.0 -1.045"/>
      <parent link="${prefix}link_1"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_3"/>
      <limit effort="15315.272850848E0" lower="${radians(-100)}" upper="${radians(144)}" velocity="${radians(90)}"/>
      <origin rpy="0.0 0.0 -${pi/2.0}" xyz="1.3 0.0 0.0"/>
      <parent link="${prefix}link_2"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_4"/>
      <limit effort="4847.11596436905E0" lower="${radians(-350)}" upper="${radians(350)}" velocity="${radians(120)}"/>
      <origin rpy="${pi/2.0} 0.0 -0.0" xyz="-0.055 0.0 0.0"/>
      <parent link="${prefix}link_3"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_5"/>
      <limit effort="4852.96953685247E0" lower="${radians(-120)}" upper="${radians(120)}" velocity="${radians(110)}"/>
      <origin rpy="-${pi/2.0} 0.0 -0.0" xyz="0.0 0.0 -1.525"/>
      <parent link="${prefix}link_4"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <axis xyz="0.0 0.0 1.0"/>
      <child link="${prefix}link_6"/>
      <limit effort="2675.4449432041E0" lower="${radians(-350)}" upper="${radians(350)}" velocity="${radians(160)}"/>
      <origin rpy="${pi/2.0} 0.0 -0.0" xyz="0.0 0.0 0.0"/>
      <parent link="${prefix}link_5"/>
    </joint>
    <!-- ROS-Industrial 'base' frame - equivalent of 'KUKA ROBROOT'-->
    <link name="${prefix}base"/>
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>
    <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
    <link name="${prefix}flange"/>
    <joint name="${prefix}link6-flange" type="fixed">
      <child link="${prefix}flange"/>
      <origin rpy="0 ${pi/2} -0.0" xyz="0.0 0.0 -0.29"/>
      <parent link="${prefix}link_6"/>
    </joint>
    <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link6-tool0" type="fixed">
      <child link="${prefix}tool0"/>
      <origin rpy="0 ${pi} -0.0" xyz="0.0 0.0 -0.29"/>
      <parent link="${prefix}link_6"/>
    </joint>
  </xacro:macro>
</robot>
